      "TIMESTAMP",
      "HOURLY_VIBRATION",
      "BG_VIBRATION",
      "BG_LOW_THRESHOLD",
      "BG_HIGH_THRESHOLD",
      "SUNTIME",
      "MOONTIME",
      "ASTRO_API_KEY",
      "OWM_API_KEY",
      "WEATHER_UNITS",
      "WEATHER_TEMP",
      "WEATHER_WIND",
      "WEATHER_UMBRELLA"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_HUMAROID_64",
          "file": "fonts/Humaroid.ttf"
        },
        {
          "type": "font",
          "name": "FONT_HUMAROID_20",
          "file": "fonts/Humaroid.ttf"
        },
        {
          "type": "font",
          "name": "FONT_HUMAROID_28",
          "file": "fonts/Humaroid.ttf"
        },
        {
