[
    {
        "type": "heading",
        "defaultValue": "BG Scout Settings"
    },
    {
        "type": "text",
        "defaultValue": "Configure your Dexcom account credentials and display preferences."
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Dexcom Account"
            },
            {
                "type": "input",
                "messageKey": "DEX_LOGIN",
                "defaultValue": "",
                "label": "Dexcom Login"
            },
            {
                "type": "input",
                "messageKey": "DEX_PASSWORD",
                "defaultValue": "",
                "label": "Dexcom Password"
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Blood Glucose"
            },
            {
                "type": "select",
                "messageKey": "BG_UNITS",
                "defaultValue": "mg/dL",
                "label": "Units",
                "options": [
                    {
                        "label": "mg/dL",
                        "value": "mg/dL"
                    },
                    {
                        "label": "mmol/L",
                        "value": "mmol/L"
                    }
                ]
            },
            {
                "type": "toggle",
                "messageKey": "BG_SHOW_DELTA",
                "defaultValue": true,
                "label": "Show BG Delta"
            },
            {
                "type": "toggle",
                "messageKey": "BG_SHOW_TIMEDELTA",
                "defaultValue": true,
                "label": "Show Time Delta"
            },
            {
                "type": "toggle",
                "messageKey": "BG_VIBRATION",
                "defaultValue": false,
                "label": "Threshold Vibration"
            },
            {
                "type": "input",
                "messageKey": "BG_LOW_THRESHOLD",
                "defaultValue": "",
                "label": "Low Threshold (in preferred units)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "input",
                "messageKey": "BG_HIGH_THRESHOLD",
                "defaultValue": "",
                "label": "High Threshold (in preferred units)",
                "attributes": {
                    "type": "number"
                }
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Watchface"
            },
            {
                "type": "select",
                "messageKey": "DATE_FORMAT",
                "defaultValue": "dd.mm",
                "label": "Date Format",
                "options": [
                    {
                        "label": "dd.mm",
                        "value": "dd.mm"
                    },
                    {
                        "label": "mm.dd",
                        "value": "mm.dd"
                    }
                ]
            },
            {
                "type": "toggle",
                "messageKey": "HOURLY_VIBRATION",
                "defaultValue": false,
                "label": "Hourly Vibration"
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Weather"
            },
            {
                "type": "text",
