                ]
            },
            {
                "type": "select",
                "messageKey": "WEATHER_INTERVAL",
                "defaultValue": "60",
                "label": "Update Interval",
                "options": [
                    {
                        "label": "Every 30 minutes",
                        "value": "30"
                    },
                    {
                        "label": "Every hour",
                        "value": "60"
                    },
                    {
                        "label": "Every 2 hours",
                        "value": "120"
                    },
                    {
                        "label": "Every 3 hours",
                        "value": "180"
                    }
                ]
            }
