[
    {
        "type": "heading",
        "defaultValue": "BG Scout Settings"
    },
    {
        "type": "text",
        "defaultValue": "Configure your Dexcom account credentials and display preferences."
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Dexcom Account"
            },
            {
                "type": "input",
                "messageKey": "DEX_LOGIN",
                "defaultValue": "",
                "label": "Dexcom Login"
            },
            {
                "type": "input",
                "messageKey": "DEX_PASSWORD",
                "defaultValue": "",
                "label": "Dexcom Password",
                "attributes": {
                    "type": "password"
                }
            },
            {
                "type": "select",
                "messageKey": "DEX_REGION",
                "defaultValue": "ous",
                "label": "Dexcom Region",
                "options": [
                    {
                        "label": "Outside US",
                        "value": "ous"
                    },
                    {
                        "label": "US",
                        "value": "us"
                    },
                    {
                        "label": "Japan",
                        "value": "jp"
                    }
                ]
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Blood Glucose"
            },
            {
                "type": "select",
                "messageKey": "BG_UNITS",
                "defaultValue": "mg/dL",
                "label": "Units",
                "options": [
                    {
                        "label": "mg/dL",
                        "value": "mg/dL"
                    },
                    {
                        "label": "mmol/L",
                        "value": "mmol/L"
                    }
                ]
            },
            {
                "type": "toggle",
                "messageKey": "BG_SHOW_DELTA",
                "defaultValue": true,
                "label": "Show BG Delta"
            },
            {
                "type": "toggle",
                "messageKey": "BG_SHOW_TIMEDELTA",
                "defaultValue": true,
                "label": "Show Time Delta"
            },
            {
                "type": "toggle",
                "messageKey": "BG_VIBRATION",
                "defaultValue": false,
                "label": "Threshold Vibration"
            },
            {
                "type": "input",
                "messageKey": "BG_LOW_THRESHOLD",
                "defaultValue": "",
                "label": "Low Threshold (in preferred units)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "input",
                "messageKey": "BG_HIGH_THRESHOLD",
                "defaultValue": "",
                "label": "High Threshold (in preferred units)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "heading",
                "defaultValue": "Night Thresholds",
                "size": 4
            },
            {
                "type": "text",
                "defaultValue": "Optional. Set separate thresholds for nighttime. If left empty, the general thresholds above are used."
            },
            {
                "type": "input",
                "messageKey": "BG_NIGHT_LOW_THRESHOLD",
                "defaultValue": "",
                "label": "Night Low Threshold (in preferred units)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "input",
                "messageKey": "BG_NIGHT_HIGH_THRESHOLD",
                "defaultValue": "",
                "label": "Night High Threshold (in preferred units)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "input",
                "messageKey": "BG_NIGHT_START",
                "defaultValue": "",
                "label": "Night Start (hour, 0-23)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "input",
                "messageKey": "BG_NIGHT_END",
                "defaultValue": "",
                "label": "Night End (hour, 0-23)",
                "attributes": {
                    "type": "number"
                }
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Watchface"
            },
            {
                "type": "select",
                "messageKey": "DATE_FORMAT",
                "defaultValue": "dd.mm",
                "label": "Date Format",
                "options": [
                    {
                        "label": "dd.mm",
                        "value": "dd.mm"
                    },
                    {
                        "label": "mm.dd",
                        "value": "mm.dd"
                    }
                ]
            },
            {
                "type": "toggle",
                "messageKey": "HOURLY_VIBRATION",
                "defaultValue": false,
                "label": "Hourly Vibration"
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Weather"
            },
            {
                "type": "text",
                "defaultValue": "Enter your OpenWeatherMap API key to display current weather. Get a free key at https://openweathermap.org/api"
            },
            {
                "type": "input",
                "messageKey": "OWM_API_KEY",
                "defaultValue": "",
                "label": "OpenWeatherMap API Key"
            },
            {
                "type": "select",
                "messageKey": "WEATHER_UNITS",
                "defaultValue": "metric",
                "label": "Units",
                "options": [
                    {
                        "label": "Metric (°C, m/s)",
                        "value": "metric"
                    },
                    {
                        "label": "Imperial (°F, mph)",
                        "value": "imperial"
                    }
                ]
            },
            {
                "type": "select",
                "messageKey": "WEATHER_INTERVAL",
                "defaultValue": "60",
                "label": "Update Interval",
                "options": [
                    {
                        "label": "Every 30 minutes",
                        "value": "30"
                    },
                    {
                        "label": "Every hour",
                        "value": "60"
                    },
                    {
                        "label": "Every 2 hours",
                        "value": "120"
                    },
                    {
                        "label": "Every 3 hours",
                        "value": "180"
                    }
                ]
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Astronomy"
            },
            {
                "type": "text",
                "defaultValue": "Enter your ipgeolocation.io API key to display sunrise/sunset and moonrise/moonset times. Get a free API key at https://ipgeolocation.io/"
            },
            {
                "type": "input",
                "messageKey": "ASTRO_API_KEY",
                "defaultValue": "",
                "label": "ipgeolocation.io API Key"
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Garbage Collection"
            },
            {
                "type": "input",
                "messageKey": "GARBAGE_PICKUP_TIME",
                "defaultValue": "9",
                "label": "Pickup Time (hour, 0-23)",
                "attributes": {
                    "type": "number"
                }
            },
            {
                "type": "checkboxgroup",
                "messageKey": "GARBAGE_ORGANIC_DAYS",
                "defaultValue": [true, false, true, false, true, false, false],
                "label": "Organic (green bag) days",
                "options": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
            },
            {
                "type": "checkboxgroup",
                "messageKey": "GARBAGE_GREY_DAYS",
                "defaultValue": [false, false, false, true, false, false, false],
                "label": "Grey bag days",
                "options": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
            },
            {
                "type": "checkboxgroup",
                "messageKey": "GARBAGE_BLACK_DAYS",
                "defaultValue": [false, true, false, false, false, true, false],
                "label": "Black bag days",
                "options": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Quick View Alerts"
            },
            {
                "type": "text",
                "defaultValue": "Show a brief overlay banner at the bottom of the watchface when a vibration alert fires. The banner displays an icon and message for the configured duration, then auto-dismisses."
            },
            {
                "type": "toggle",
                "messageKey": "ALERT_OVERLAY_ENABLE",
                "defaultValue": false,
                "label": "Enable Overlay Alerts"
            },
            {
                "type": "select",
                "messageKey": "ALERT_OVERLAY_DURATION",
                "defaultValue": "5",
                "label": "Duration (seconds)",
                "options": [
                    { "label": "1s", "value": "1" },
                    { "label": "2s", "value": "2" },
                    { "label": "3s", "value": "3" },
                    { "label": "4s", "value": "4" },
                    { "label": "5s", "value": "5" },
                    { "label": "6s", "value": "6" },
                    { "label": "7s", "value": "7" },
                    { "label": "8s", "value": "8" },
                    { "label": "9s", "value": "9" },
                    { "label": "10s", "value": "10" },
                    { "label": "11s", "value": "11" },
                    { "label": "12s", "value": "12" },
                    { "label": "13s", "value": "13" },
                    { "label": "14s", "value": "14" },
                    { "label": "15s", "value": "15" }
                ]
            },
            {
                "type": "button",
                "id": "overlay-test",
                "defaultValue": "\u25b6 Test Alert Overlay"
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Vibration Test"
            },
            {
                "type": "text",
                "defaultValue": "Tap a button below to save your settings and test the vibration pattern on the watch. The settings page will close — reopen it from the app to continue editing."
            },
            {
                "type": "button",
                "id": "vibe-test-high",
                "defaultValue": "▶ Test High BG Alert"
            },
            {
                "type": "button",
                "id": "vibe-test-low",
                "defaultValue": "▶ Test Low BG Alert"
            },
            {
                "type": "button",
                "id": "vibe-test-hourly",
                "defaultValue": "▶ Test Hourly Vibration"
            }
        ]
    },
    {
        "type": "submit",
        "defaultValue": "Save Settings"
    }
]