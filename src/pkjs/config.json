    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Astronomy"
            },
            {
                "type": "text",
                "defaultValue": "Enter your ipgeolocation.io API key to display sunrise/sunset and moonrise/moonset times. Get a free API key at https://ipgeolocation.io/"
            },
            {
                "type": "input",
                "messageKey": "ASTRO_API_KEY",
                "defaultValue": "",
